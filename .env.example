# Optional real LLM reasoning (Gemini is the default)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI remains supported as an alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional on-chain provider key; public endpoints still use fallback on failure
ETHERSCAN_API_KEY=

# Optional path to the competition-provided OHLCV CSV
OHLCV_CSV_PATH=data/ohlcv.csv
