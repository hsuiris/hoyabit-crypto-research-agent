# 可選的真實 LLM 推理。可選 bedrock、gemini、openai 或 none。
# Bedrock 使用環境中的 AWS 憑證（例如 Lambda execution role）；請勿在此放入 AWS access key。
# AWS_REGION／AWS_DEFAULT_REGION 為標準 AWS SDK 區域設定。
#
# region 與 model ID 的組合經實測確認（2026-08-01，帳號 WSParticipantRole）：
# us-west-2 的 amazon.nova-lite-v1:0 支援 ON_DEMAND，可直接以裸 model ID 呼叫 Converse，
# 不需要 cross-Region inference profile。us.amazon.nova-lite-v1:0 亦可用，但非必要。
#
# 模型可用性依 region 而異，這不是理論風險：同一帳號下 amazon.nova-micro-v1:0 的裸 ID
# 在 us-east-1 可呼叫，在 us-west-2 卻回報 on-demand throughput isn't supported，
# 必須改用 us.amazon.nova-micro-v1:0。改動 region 前務必重跑 aws/verify-permissions.sh。
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-west-2
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.2

# Gemini 仍可作為替代 provider。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI 仍可作為替代 provider。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可選的鏈上 provider key；公開端點失敗時仍會使用 fallback。
ETHERSCAN_API_KEY=

# 可選的競賽提供 OHLCV CSV 路徑。
OHLCV_CSV_PATH=data/ohlcv.csv


# =====================================================================================
# AWS 部署（選用）
# =====================================================================================
#
# 只有要部署到 AWS 時才需要這一段。純本機執行（python -m src.app）完全不需要。
#
# 使用方式：把本檔複製為 .env 並填入實際值。.env 已被 .gitignore 排除，永遠不會進版控。
#   cp .env.example .env
#
# aws/deploy.sh 會讀取 .env，因此填好之後可以直接跑：
#   bash aws/deploy.sh
# 而不必每次打 --region / --model-id / --concurrency 等一長串參數。
#
# 優先序：命令行參數 > 既有環境變數 > .env > 腳本預設值。

# ---- 你決定的設定 ----
# 這些是輸入，適合長期放在 .env。
# 注意 region 與 model ID 是一組，不可分開改：模型可用形式依 region 而異。
# 換 region 前先跑 aws/verify-permissions.sh 的第 3 項重新實測。
DEPLOY_STACK_NAME=hoyabit-agent-mvp
DEPLOY_AUTH_TYPE=NONE
DEPLOY_CONCURRENCY=5
DEPLOY_LOG_RETENTION=7

# ---- AWS 回傳的執行結果 ----
# 這些不是設定，是部署後 AWS 給你的值。可以留空。
#
# 它們會隨 stack 重建而改變（delete-stack 再建就會換一個新的 Function URL），
# 因此「動態查詢」才是真實來源，填在這裡只是為了本機方便與供 scripts/check_secrets.sh
# 精確掃描使用。不要把這裡的值當成可信的最新狀態。
#
# 查詢方式：
#   aws sts get-caller-identity --query Account --output text
#   aws cloudformation describe-stacks --region "$AWS_REGION" \
#     --stack-name "$DEPLOY_STACK_NAME" \
#     --query "Stacks[0].Outputs[?OutputKey=='PublicUrl'].OutputValue" --output text
#
# 為什麼要保密：Function URL 的 AuthType 是 NONE，任何取得網址的人都能觸發完整研究
# 執行並消耗 Bedrock 配額。帳號 ID 不是密鑰，但公開它沒有好處。
AWS_ACCOUNT_ID=
DEPLOY_FUNCTION_URL=

# ---- 絕對不要寫在這裡的東西 ----
# AWS 憑證一律走標準 credential chain（aws configure / SSO / Workshop 提供的 export），
# 不要把 access key、secret access key 或 session token 寫進 .env 或任何版控檔案。
# Bedrock 使用 Lambda execution role 或本機的 credential chain，不需要 API key。
